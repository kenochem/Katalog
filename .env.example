# Skopiuj ten plik jako `.env` i uzupełnij wartości.
# NIE commituj prawdziwego `.env` do gita.

# Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Tylko lokalnie / skrypty / deploy Edge Functions — nie wrzucaj na GitHub
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Migracje SQL (ulubione, foldery) — URI z Dashboard → Database:
# DATABASE_URL=postgresql://postgres.[ref]:[HASLO]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Potem: npm run db:user-sync

# Opcjonalnie — zamówienie → Discord (po zmianie: npm run deploy)
# VITE_DISCORD_ORDERS_WEBHOOK=https://discord.com/api/webhooks/...

# Produkt buildu (dev): suite | catalog — domyślnie suite w npm run dev
# VITE_APP_PRODUCT=suite

# Web Push (Talk PWA) — para kluczy VAPID (np. npx web-push generate-vapid-keys)
# VITE_VAPID_PUBLIC_KEY=
# Te same klucze + CHAT_PUSH_WEBHOOK_SECRET w Secrets funkcji chat-push (Supabase)

# Bot uzupełniający wiedzę produktową (Edge Function product-knowledge):
# KNOWLEDGE_BOT_SECRET=  → Supabase Secrets + nagłówek X-Knowledge-Bot-Key
# docs/products/KNOWLEDGE-BOT-API.md

# VITE_GEMINI_API_KEY=
