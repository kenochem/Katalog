# Skopiuj na serwer jako C:\katalog-sync\katalog-sync.env
# NIE commituj prawdziwego service_role do gita!

SUPABASE_URL=https://fgkkvbniyjysgqcjuxpl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=wklej_service_role_z_supabase_dashboard

# Opcjonalnie — gdy sqlcmd nie łączy się na localhost (instancja na innym hoście):
# WAPRO_SQL_SERVER=DESKTOP-PANA1RQ
# WAPRO_SQL_DATABASE=WAPRO

# Gdy SQL Mag nie zwraca kolumn cen (sync i tak robi stany, potem proba cen osobno):
# WAPRO_PRICE_SQL=SELECT ... (sku + 3 kolumny cen, jak w sync-wapro-stock-server.ps1)

# Statystyki sprzedaży (zakładka Sprzedaż w katalogu) — opcjonalnie własne zapytanie z __SKU__:
# WAPRO_SALES_SQL=SET NOCOUNT ON; DECLARE @sku varchar(50) = N'__SKU__'; ...
# CSV z XLS (python scripts/enrich-shop-prices-from-wapro.py → skopiuj data/wapro-stock.csv):
# WAPRO_PRICE_CSV=C:\katalog-sync\wapro-prices.csv

# Auto-dopinanie nowych SKU po sync (Node + wapro-mag-catalog.json w C:\katalog-sync):
# WAPRO_AUTO_IMPORT=0
# Instalacja skryptow Node na serwerze: powershell -File scripts\install-wapro-sync-bundle.ps1
